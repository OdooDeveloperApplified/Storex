<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Document Layout template -->
    <template id="document_sale_component_shortage" >
        <t t-call="web.basic_layout">
            <div>
                <div class="o_boxed_header">
                    <div class="row mb-2">
                        <div class="col-12 text-end mb-2">
                            <img t-if="res_company.logo" t-att-src="image_data_uri(res_company.logo)" alt="Logo" style="max-height: 80px;"/>
                        </div>
                    </div>
                </div>
            </div>
            <div>
                <t t-out="0"/>
            </div>
            <div t-attf-class="footer o_company_#{res_company.id}_layout {{report_type != 'pdf' and 'mt-auto'}}">
                <div class="o_footer_content d-flex border-top pt-2">
                    <div class="text-end text-muted">
                        <div t-if="report_type == 'pdf' and display_name_in_footer" t-out="o.name">(document name)</div>
                        <div t-if="report_type == 'pdf'">Page <span class="page"/> / <span class="topage"/></div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Report Template -->
    <template id="report_sale_shortage_template">
        <t t-call="web.html_container">
            <div class="container mt-4">
                <t t-foreach="docs" t-as="line">
                    <t t-call="storex_sales_shortage.document_sale_component_shortage">
                        <div class="page">
                            <!-- Header -->
                            <div class="row mb-4">
                                <div class="col-8">
                                    <h2>Sale Order Line Shortage Analysis Report</h2>
                                    <h4 class="text-muted">Sale Order: <t t-esc="line.order_id.name"/></h4>
                                </div>
                            </div>

                            <!-- Line Details -->
                            <div class="row mb-4">
                                <div class="col-md-6">
                                    <table class="table table-sm table-bordered">
                                        <tr>
                                            <th width="40%">Product</th>
                                            <td><t t-esc="line.product_id.display_name"/></td>
                                        </tr>
                                        <tr>
                                            <th>Ordered Quantity</th>
                                            <td><t t-esc="'{:,.2f}'.format(line.product_uom_qty)"/> <t t-esc="line.product_uom.name"/></td>
                                        </tr>
                                    </table>
                                </div>
                            </div>

                            <!-- Summary Section -->
                            <div class="row mb-4">
                                <div class="col-md-12">
                                    <div class="alert alert-info">
                                        <strong>Summary:</strong>
                                        <ul>
                                            <li>Total Components: <t t-esc="len(line.shortage_line_ids)"/></li>
                                            <li>Components with Shortage: 
                                                <t t-set="shortage_count" t-value="0"/>
                                                <t t-foreach="line.shortage_line_ids" t-as="sline">
                                                    <t t-if="sline.shortage_qty > 0">
                                                        <t t-set="shortage_count" t-value="shortage_count + 1"/>
                                                    </t>
                                                </t>
                                                <t t-esc="shortage_count"/>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            </div>

                            <!-- Raw Material Section -->
                            <div class="row mb-4">
                                <div class="col-md-12">
                                    <h3 class="bg-secondary text-white p-2">Raw Material Section</h3>
                                    <table class="table table-bordered table-striped">
                                        <thead>
                                            <tr>
                                                <th style="font-weight:bold;">Component</th>
                                                <th class="text-right" style="font-weight:bold;">Required Qty</th>
                                                <th class="text-right" style="font-weight:bold;">Available Qty</th>
                                                <th class="text-right" style="font-weight:bold;">Shortage Qty</th>
                                                <th style="font-weight:bold;">Location Details</th>
                                                <th style="font-weight:bold;">Component Path</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-set="has_raw_materials" t-value="0"/>
                                            <t t-foreach="line.shortage_line_ids" t-as="sline">
                                                <t t-if="sline.is_raw_material == True and sline.shortage_qty > 0">
                                                    <t t-set="has_raw_materials" t-value="1"/>
                                                    <tr class="table-danger">
                                                        <td><t t-esc="sline.product_id.display_name"/> [Raw Material]</td>
                                                        <td class="text-right"><t t-esc="'{:,.2f}'.format(sline.required_qty)"/></td>
                                                        <td class="text-right"><t t-esc="'{:,.2f}'.format(sline.available_qty)"/></td>
                                                        <td class="text-right">
                                                            <strong class="text-danger">
                                                                <t t-esc="'{:,.2f}'.format(sline.shortage_qty)"/>
                                                            </strong>
                                                        </td>
                                                        <td><t t-esc="sline.location_details or 'No stock'"/></td>
                                                        <td><t t-esc="sline.component_path"/></td>
                                                    </tr>
                                                </t>
                                            </t>
                                            <t t-if="has_raw_materials == 0">
                                                <tr>
                                                    <td colspan="7" class="text-center text-muted">No raw material shortages found</td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <!-- Buffing Location Section -->
                            <div class="row mb-4">
                                <div class="col-md-12">
                                    <h3 class="bg-secondary text-white p-2">Buffing Section</h3>
                                    <table class="table table-bordered table-striped">
                                        <thead>
                                            <tr>
                                                <th style="font-weight:bold;">Component</th>
                                                <th class="text-right" style="font-weight:bold;">Required Qty</th>
                                                <th class="text-right" style="font-weight:bold;">Available Qty</th>
                                                <th class="text-right" style="font-weight:bold;">Shortage Qty</th>
                                                <th style="font-weight:bold;">Location Details</th>
                                                <th style="font-weight:bold;">Component Path</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-set="has_buffing" t-value="0"/>
                                            <t t-foreach="line.shortage_line_ids" t-as="sline">
                                                <t t-if="sline.is_raw_material == False and sline.shortage_qty &gt; 0 and 'buff' in sline.product_id.display_name.lower()">
                                                    <t t-set="has_buffing" t-value="1"/>
                                                    <tr class="table-danger">
                                                        <td><t t-esc="sline.product_id.display_name"/> [Buffing]</td>
                                                        <td class="text-right"><t t-esc="'{:,.2f}'.format(sline.required_qty)"/></td>
                                                        <td class="text-right"><t t-esc="'{:,.2f}'.format(sline.available_qty)"/></td>
                                                        <td class="text-right">
                                                            <strong class="text-danger">
                                                                <t t-esc="'{:,.2f}'.format(sline.shortage_qty)"/>
                                                            </strong>
                                                        </td>
                                                        <td><t t-esc="sline.location_details or 'No stock'"/></td>
                                                        <td><t t-esc="sline.component_path"/></td>
                                                    </tr>
                                                </t>
                                            </t>
                                            <t t-if="has_buffing == 0">
                                                <tr>
                                                    <td colspan="7" class="text-center text-muted">No buffing component shortages found</td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <!-- Turning Location Section -->
                            <div class="row mb-4">
                                <div class="col-md-12">
                                    <h3 class="bg-secondary text-white p-2">Turning Section</h3>
                                    <table class="table table-bordered table-striped">
                                        <thead>
                                            <tr>
                                                <th style="font-weight:bold;">Component</th>
                                                <th class="text-right" style="font-weight:bold;">Required Qty</th>
                                                <th class="text-right" style="font-weight:bold;">Available Qty</th>
                                                <th class="text-right" style="font-weight:bold;">Shortage Qty</th>
                                                <th style="font-weight:bold;">Location Details</th>
                                                <th style="font-weight:bold;">Component Path</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-set="has_turning" t-value="0"/>
                                            <t t-foreach="line.shortage_line_ids" t-as="sline">
                                                <t t-if="sline.is_raw_material == False and sline.shortage_qty &gt; 0 and 'turn' in sline.product_id.display_name.lower()">
                                                    <t t-set="has_turning" t-value="1"/>
                                                    <tr class="table-danger">
                                                        <td><t t-esc="sline.product_id.display_name"/> [Turning]</td>
                                                        <td class="text-right"><t t-esc="'{:,.2f}'.format(sline.required_qty)"/></td>
                                                        <td class="text-right"><t t-esc="'{:,.2f}'.format(sline.available_qty)"/></td>
                                                        <td class="text-right">
                                                            <strong class="text-danger">
                                                                <t t-esc="'{:,.2f}'.format(sline.shortage_qty)"/>
                                                            </strong>
                                                        </td>
                                                        <td><t t-esc="sline.location_details or 'No stock'"/></td>
                                                        <td><t t-esc="sline.component_path"/></td>
                                                    </tr>
                                                </t>
                                            </t>
                                            <t t-if="has_turning == 0">
                                                <tr>
                                                    <td colspan="7" class="text-center text-muted">No turning component shortages found</td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <!-- Chroming Location Section -->
                            <div class="row mb-4">
                                <div class="col-md-12">
                                    <h3 class="bg-secondary text-white p-2">Chroming Section</h3>
                                    <table class="table table-bordered table-striped">
                                        <thead>
                                            <tr>
                                                <th style="font-weight:bold;">Component</th>
                                                <th class="text-right" style="font-weight:bold;">Required Qty</th>
                                                <th class="text-right" style="font-weight:bold;">Available Qty</th>
                                                <th class="text-right" style="font-weight:bold;">Shortage Qty</th>
                                                <th style="font-weight:bold;">Location Details</th>
                                                <th style="font-weight:bold;">Component Path</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-set="has_chroming" t-value="0"/>
                                            <t t-foreach="line.shortage_line_ids" t-as="sline">
                                                <t t-if="sline.is_raw_material == False and sline.shortage_qty &gt; 0 and ('chrom' in sline.product_id.display_name.lower() or 'plate' in sline.product_id.display_name.lower())">
                                                    <t t-set="has_chroming" t-value="1"/>
                                                    <tr class="table-danger">
                                                        <td><t t-esc="sline.product_id.display_name"/> [Chroming]</td>
                                                        <td class="text-right"><t t-esc="'{:,.2f}'.format(sline.required_qty)"/></td>
                                                        <td class="text-right"><t t-esc="'{:,.2f}'.format(sline.available_qty)"/></td>
                                                        <td class="text-right">
                                                            <strong class="text-danger">
                                                                <t t-esc="'{:,.2f}'.format(sline.shortage_qty)"/>
                                                            </strong>
                                                        </td>
                                                        <td><t t-esc="sline.location_details or 'No stock'"/></td>
                                                        <td><t t-esc="sline.component_path"/></td>
                                                    </tr>
                                                </t>
                                            </t>
                                            <t t-if="has_chroming == 0">
                                                <tr>
                                                    <td colspan="7" class="text-center text-muted">No chroming component shortages found</td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <!-- Coating Section -->
                            <div class="row mb-4">
                                <div class="col-md-12">
                                    <h3 class="bg-secondary text-white p-2">Coating Section</h3>
                                    <table class="table table-bordered table-striped">
                                        <thead>
                                            <tr>
                                                <th style="font-weight:bold;">Component</th>
                                                <th class="text-right" style="font-weight:bold;">Required Qty</th>
                                                <th class="text-right" style="font-weight:bold;">Available Qty</th>
                                                <th class="text-right" style="font-weight:bold;">Shortage Qty</th>
                                                <th style="font-weight:bold;">Location Details</th>
                                                <th style="font-weight:bold;">Component Path</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-set="has_coating_items" t-value="0"/>
                                            <t t-foreach="line.shortage_line_ids" t-as="sline">
                                                <t t-if="sline.is_raw_material == False and sline.shortage_qty &gt; 0 and 'coat' in sline.product_id.display_name.lower()">
                                                    <t t-set="has_coating_items" t-value="1"/>
                                                    <tr class="table-danger">
                                                        <td><t t-esc="sline.product_id.display_name"/> [Coating]</td>
                                                        <td class="text-right"><t t-esc="'{:,.2f}'.format(sline.required_qty)"/></td>
                                                        <td class="text-right"><t t-esc="'{:,.2f}'.format(sline.available_qty)"/></td>
                                                        <td class="text-right">
                                                            <strong class="text-danger">
                                                                <t t-esc="'{:,.2f}'.format(sline.shortage_qty)"/>
                                                            </strong>
                                                        </td>
                                                        <td><t t-esc="sline.location_details or 'No stock'"/></td>
                                                        <td><t t-esc="sline.component_path"/></td>
                                                    </tr>
                                                </t>
                                            </t>
                                            <t t-if="has_coating_items == 0">
                                                <tr>
                                                    <td colspan="7" class="text-center text-muted">No coating component shortages found</td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </t>
                </t>
            </div>
        </t>
    </template>

    <!-- Report Action -->
    <record id="action_report_sale_shortage" model="ir.actions.report">
        <field name="name">Sale Line Shortage Report</field>
        <field name="model">sale.order.line</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">storex_sales_shortage.report_sale_shortage_template</field>
        <field name="report_file">storex_sales_shortage.report_sale_shortage_template</field>
        <field name="binding_model_id" ref="sale.model_sale_order_line"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="storex_manufacture.paperformat_component_shortage"/>
        <field name="print_report_name">'Sale_Shortage_Report_%s' % (object.order_id.name)</field>
    </record>
</odoo>
